diff --git a/etc/config.sh/settings b/etc/config.sh/settings
index 0a69a70190..ff8efd536e 100644
--- a/etc/config.sh/settings
+++ b/etc/config.sh/settings
@@ -124,6 +124,25 @@ Linux)
     esac
     ;;
 
+FreeBSD)
+    case `uname -m` in
+    amd64|x86_64)
+        WM_ARCH=freebsd64
+        export WM_ARCH_OPTION=64
+        export WM_COMPILER_LIB_ARCH=64
+        export WM_CC='clang'
+        export WM_CXX='clang++'
+        export WM_CFLAGS='-m64 -fPIC'
+        export WM_CXXFLAGS='-m64 -fPIC -std=c++14'
+        export WM_LDFLAGS='-m64'
+        ;;
+
+    *)
+        echo "Unknown processor type `uname -m` for FreeBSD" 1>&2
+        ;;
+    esac
+    ;;
+
 SunOS)
     WM_ARCH=SunOS64
     WM_MPLIB=FJMPI
