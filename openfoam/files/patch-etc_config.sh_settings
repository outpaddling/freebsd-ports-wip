--- etc/config.sh/settings.orig	2026-08-24 14:46:54 UTC
+++ etc/config.sh/settings
@@ -35,6 +35,19 @@ case "$WM_ARCH" in
 
 # Define compilation flags for the system type
 case "$WM_ARCH" in
+FreeBSD)
+    case `uname -m` in
+    amd64|aarch64|x86_64)
+        WM_ARCH=FreeBSD
+        export WM_ARCH_OPTION=64
+        export WM_COMPILER_LIB_ARCH=64
+        export WM_CC='clang'
+        export WM_CXX='clang++'
+        export WM_CFLAGS='-fPIC'
+        export WM_CXXFLAGS='-fPIC -std=c++14'
+        export WM_LDFLAGS=''
+        ;;
+
 Linux)
     WM_ARCH=linux
 
