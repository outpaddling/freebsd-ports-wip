--- etc/config.sh/settings.orig	2026-08-06 18:47:53 UTC
+++ etc/config.sh/settings
@@ -35,6 +35,21 @@ case "$WM_ARCH" in
 
 # Define compilation flags for the system type
 case "$WM_ARCH" in
+FreeBSD)
+    case `uname -m` in
+    amd64|aarch64|x86_64)
+        WM_ARCH=FreeBSD
+        export WM_ARCH_OPTION=64
+        export WM_COMPILER_LIB_ARCH=64
+        export WM_CC='clang'
+        export WM_CXX='clang++'
+        export WM_CFLAGS='-fPIC'
+        export WM_CXXFLAGS='-fPIC -std=c++14'
+        export WM_LDFLAGS=
+        ;;
+    esac
+    ;;
+
 Linux)
     WM_ARCH=linux
 
@@ -47,7 +62,7 @@ Linux)
         export WM_CFLAGS='-fPIC'
         export WM_CXXFLAGS='-fPIC -std=c++0x'
         export WM_LDFLAGS=
-    ;;
+        ;;
 
     x86_64)
         case "$WM_ARCH_OPTION" in
